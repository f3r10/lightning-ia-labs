# Copy of this file: .env (make up-lab1 creates it for you). Never commit .env.
# These values only protect a local test wallet on regtest. They are examples.
LNBITS_URL=http://127.0.0.1:5001
LNBITS_ADMIN_USER=labadmin
LNBITS_ADMIN_PASSWORD=change-me-regtest-only
# The NWC connection string is a secret. make lab1-connection fills this in.
NWC_CONNECTION_STRING=nostr+walletconnect://fakepubkey?relay=ws://127.0.0.1:7777&secret=fakesecret
