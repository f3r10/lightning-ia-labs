# just up-lab2 creates .env from this file. Never commit .env.
# These values only protect a local test wallet on regtest. They are examples.
LNBITS_URL=http://127.0.0.1:5002
LNBITS_ADMIN_USER=labadmin
LNBITS_ADMIN_PASSWORD=change-me-regtest-only
# The invoice key is a secret that belongs on your server. just up-lab2 fills this in.
LNBITS_INVOICE_KEY=fake-invoice-key
# The address of your store. The check looks for it here.
STORE_URL=http://127.0.0.1:3002
