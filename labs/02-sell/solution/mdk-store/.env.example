# Copy to .env.local for local runs. On Vercel, set the same names as environment variables.
# npx @moneydevkit/create writes the first two for you. Never commit real values.
MDK_ACCESS_TOKEN=fake-access-token
MDK_MNEMONIC=fake mnemonic words go here
# The webhook signing secret, from the moneydevkit dashboard (Apps, your app, Webhooks).
MDK_WEBHOOK_SECRET=whsec_fake

# Signet staging only (MutinyNet). Remove these lines for mainnet.
MDK_API_BASE_URL=https://staging.moneydevkit.com/rpc
MDK_NETWORK=signet
MDK_VSS_URL=https://vss.staging.moneydevkit.com/vss
MDK_ESPLORA_URL=https://mutinynet.com/api
MDK_RGS_URL=https://rgs.staging.moneydevkit.com/snapshot
MDK_LSP_NODE_ID=03fd9a377576df94cc7e458471c43c400630655083dee89df66c6ad38d1b7acffd
MDK_LSP_ADDRESS=lsp.staging.moneydevkit.com:9735
